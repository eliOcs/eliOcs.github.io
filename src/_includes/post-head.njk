<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
{% if prism and not prismAfterSiteStyles %}
  {% include "prism-styles.njk" %}
{% endif %}
<link rel="stylesheet" href="/style.css" />
<link rel="canonical" href="{{ site.url }}{{ permalink }}" />
<link
  rel="alternate"
  type="application/atom+xml"
  title="{{ site.title }}"
  href="/feed.xml"
/>
{% if prism and prismAfterSiteStyles %}
  {% include "prism-styles.njk" %}
{% endif %}
<title>{{ metaTitle or title }} - {{ site.author }}</title>
<meta name="description" content="{{ description }}" />
<meta name="author" content="{{ site.author }}" />

<meta property="og:type" content="article" />
<meta property="article:published_time" content="{{ published }}" />
<meta property="og:url" content="{{ site.url }}{{ permalink }}" />
<meta property="og:title" content="{{ title }}" />
<meta property="og:description" content="{{ description }}" />
{% if image %}<meta property="og:image" content="{{ image }}" />{% endif %}

<meta name="twitter:card" content="{{ twitterCard or 'summary_large_image' }}" />
<meta name="twitter:url" content="{{ site.url }}{{ permalink }}" />
<meta name="twitter:title" content="{{ title }}" />
<meta name="twitter:description" content="{{ description }}" />
{% if image %}<meta name="twitter:image" content="{{ image }}" />{% endif %}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "@id": {{ (site.url + permalink + "#article") | jsonString | safe }},
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": {{ (site.url + permalink) | jsonString | safe }}
    },
    "headline": {{ title | jsonString | safe }},
    "description": {{ description | jsonString | safe }},
    "datePublished": {{ published | jsonString | safe }},
    "dateModified": {{ (updated or published) | jsonString | safe }},
    "author": {
      "@type": "Person",
      "@id": "https://eliocapella.com/#person",
      "name": "Elio Capella Sánchez",
      "url": "https://eliocapella.com/"
    },
    "publisher": {
      "@id": "https://eliocapella.com/#person"
    }{% if image %},
    "image": {{ image | jsonString | safe }}{% endif %}
  }
</script>
